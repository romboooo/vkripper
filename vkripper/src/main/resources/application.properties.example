spring.application.name=vkripper
server.port=8080

app.mqtt.broker-url=tcp://localhost:1883
app.mqtt.client-id=vkripper
app.mqtt.financial-operation-topic=VirtualTopic/financial-operation/requested
app.mqtt.username=
app.mqtt.password=

app.camunda.base-url=http://localhost:18080/engine-rest
app.camunda.purchase-process-key=purchase-process
app.camunda.worker.enabled=false
app.camunda.worker.id=vkripper-worker
app.camunda.worker.validate-purchase-topic=validate-purchase
app.camunda.worker.create-balance-purchase-topic=create-balance-purchase
app.camunda.worker.publish-financial-operation-topic=publish-financial-operation
app.camunda.worker.create-jira-issue-topic=create-jira-issue
app.camunda.worker.cleanup-old-carts-topic=cleanup-old-carts
app.camunda.worker.cleanup-old-carts-older-than-minutes=262800
app.camunda.worker.lock-duration=10000
app.camunda.worker.poll-delay=5000

app.jira-adapter.enabled=true
app.jira-adapter.connection-factory-jndi-name=java:/eis/JiraConnectionFactory

app.quartz.cleanup-old-carts.enabled=true
