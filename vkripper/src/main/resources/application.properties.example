spring.application.name=vkripper
server.port=8080

app.mqtt.broker-url=tcp://localhost:1883
app.mqtt.client-id=vkripper
app.mqtt.financial-operation-topic=VirtualTopic/financial-operation/requested
app.mqtt.username=
app.mqtt.password=

app.camunda.base-url=${APP_CAMUNDA_BASE_URL:http://localhost:18080/engine-rest}
app.camunda.purchase-process-key=${APP_CAMUNDA_PURCHASE_PROCESS_KEY:purchase-process}
app.camunda.cart-add-process-key=${APP_CAMUNDA_CART_ADD_PROCESS_KEY:cart-add-process}
app.camunda.cart-update-process-key=${APP_CAMUNDA_CART_UPDATE_PROCESS_KEY:cart-update-process}
app.camunda.cart-remove-process-key=${APP_CAMUNDA_CART_REMOVE_PROCESS_KEY:cart-remove-process}
app.camunda.favorite-add-process-key=${APP_CAMUNDA_FAVORITE_ADD_PROCESS_KEY:favorite-add-process}
app.camunda.favorite-remove-process-key=${APP_CAMUNDA_FAVORITE_REMOVE_PROCESS_KEY:favorite-remove-process}
app.camunda.review-create-process-key=${APP_CAMUNDA_REVIEW_CREATE_PROCESS_KEY:review-create-process}
app.camunda.review-update-process-key=${APP_CAMUNDA_REVIEW_UPDATE_PROCESS_KEY:review-update-process}
app.camunda.review-delete-process-key=${APP_CAMUNDA_REVIEW_DELETE_PROCESS_KEY:review-delete-process}
app.camunda.product-create-process-key=${APP_CAMUNDA_PRODUCT_CREATE_PROCESS_KEY:product-create-process}
app.camunda.product-delete-process-key=${APP_CAMUNDA_PRODUCT_DELETE_PROCESS_KEY:product-delete-process}
app.camunda.worker.enabled=${APP_CAMUNDA_WORKER_ENABLED:true}
app.camunda.worker.id=${APP_CAMUNDA_WORKER_ID:vkripper-worker}
app.camunda.worker.validate-purchase-topic=${APP_CAMUNDA_WORKER_VALIDATE_PURCHASE_TOPIC:validate-purchase}
app.camunda.worker.create-balance-purchase-topic=${APP_CAMUNDA_WORKER_CREATE_BALANCE_PURCHASE_TOPIC:create-balance-purchase}
app.camunda.worker.publish-financial-operation-topic=${APP_CAMUNDA_WORKER_PUBLISH_FINANCIAL_OPERATION_TOPIC:publish-financial-operation}
app.camunda.worker.create-jira-issue-topic=${APP_CAMUNDA_WORKER_CREATE_JIRA_ISSUE_TOPIC:create-jira-issue}
app.camunda.worker.cleanup-old-carts-topic=${APP_CAMUNDA_WORKER_CLEANUP_OLD_CARTS_TOPIC:cleanup-old-carts}
app.camunda.worker.validate-cart-add-topic=${APP_CAMUNDA_WORKER_VALIDATE_CART_ADD_TOPIC:validate-cart-add}
app.camunda.worker.execute-cart-add-topic=${APP_CAMUNDA_WORKER_EXECUTE_CART_ADD_TOPIC:execute-cart-add}
app.camunda.worker.validate-cart-update-topic=${APP_CAMUNDA_WORKER_VALIDATE_CART_UPDATE_TOPIC:validate-cart-update}
app.camunda.worker.execute-cart-update-topic=${APP_CAMUNDA_WORKER_EXECUTE_CART_UPDATE_TOPIC:execute-cart-update}
app.camunda.worker.validate-cart-remove-topic=${APP_CAMUNDA_WORKER_VALIDATE_CART_REMOVE_TOPIC:validate-cart-remove}
app.camunda.worker.execute-cart-remove-topic=${APP_CAMUNDA_WORKER_EXECUTE_CART_REMOVE_TOPIC:execute-cart-remove}
app.camunda.worker.validate-favorite-add-topic=${APP_CAMUNDA_WORKER_VALIDATE_FAVORITE_ADD_TOPIC:validate-favorite-add}
app.camunda.worker.execute-favorite-add-topic=${APP_CAMUNDA_WORKER_EXECUTE_FAVORITE_ADD_TOPIC:execute-favorite-add}
app.camunda.worker.validate-favorite-remove-topic=${APP_CAMUNDA_WORKER_VALIDATE_FAVORITE_REMOVE_TOPIC:validate-favorite-remove}
app.camunda.worker.execute-favorite-remove-topic=${APP_CAMUNDA_WORKER_EXECUTE_FAVORITE_REMOVE_TOPIC:execute-favorite-remove}
app.camunda.worker.validate-review-create-topic=${APP_CAMUNDA_WORKER_VALIDATE_REVIEW_CREATE_TOPIC:validate-review-create}
app.camunda.worker.execute-review-create-topic=${APP_CAMUNDA_WORKER_EXECUTE_REVIEW_CREATE_TOPIC:execute-review-create}
app.camunda.worker.validate-review-update-topic=${APP_CAMUNDA_WORKER_VALIDATE_REVIEW_UPDATE_TOPIC:validate-review-update}
app.camunda.worker.execute-review-update-topic=${APP_CAMUNDA_WORKER_EXECUTE_REVIEW_UPDATE_TOPIC:execute-review-update}
app.camunda.worker.validate-review-delete-topic=${APP_CAMUNDA_WORKER_VALIDATE_REVIEW_DELETE_TOPIC:validate-review-delete}
app.camunda.worker.execute-review-delete-topic=${APP_CAMUNDA_WORKER_EXECUTE_REVIEW_DELETE_TOPIC:execute-review-delete}
app.camunda.worker.validate-product-create-topic=${APP_CAMUNDA_WORKER_VALIDATE_PRODUCT_CREATE_TOPIC:validate-product-create}
app.camunda.worker.execute-product-create-topic=${APP_CAMUNDA_WORKER_EXECUTE_PRODUCT_CREATE_TOPIC:execute-product-create}
app.camunda.worker.validate-product-delete-topic=${APP_CAMUNDA_WORKER_VALIDATE_PRODUCT_DELETE_TOPIC:validate-product-delete}
app.camunda.worker.execute-product-delete-topic=${APP_CAMUNDA_WORKER_EXECUTE_PRODUCT_DELETE_TOPIC:execute-product-delete}
app.camunda.worker.cleanup-old-carts-older-than-minutes=${APP_CAMUNDA_WORKER_CLEANUP_OLD_CARTS_OLDER_THAN_MINUTES:262800}
app.camunda.worker.lock-duration=${APP_CAMUNDA_WORKER_LOCK_DURATION:10000}
app.camunda.worker.poll-delay=${APP_CAMUNDA_WORKER_POLL_DELAY:5000}

app.jira-adapter.enabled=${APP_JIRA_ADAPTER_ENABLED:true}
app.jira-adapter.connection-factory-jndi-name=java:/eis/JiraConnectionFactory

app.quartz.cleanup-old-carts.enabled=${APP_QUARTZ_CLEANUP_OLD_CARTS_ENABLED:false}
